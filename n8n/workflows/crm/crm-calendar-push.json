    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst secret = $env.AUTOMATION_WEBHOOK_SECRET || '';\nconst item = $input.all()[0].json;\nconst headers = item.headers || {};\nconst body = item.body || {};\nconst envelope = { eventId: body.eventId, name: body.name, businessId: body.businessId, occurredAt: body.occurredAt, data: body.data };\nconst rawBody = JSON.stringify(envelope);\nconst ts = Number(headers['x-automation-timestamp']);\nconst sig = String(headers['x-automation-signature'] || '');\nlet validSig = false;\ntry {\n  const expected = crypto.createHmac('sha256', secret).update(`${ts}.${rawBody}`).digest('hex');\n  const a = Buffer.from(expected, 'hex');\n  const b = Buffer.from(sig, 'hex');\n  validSig = a.length === b.length && crypto.timingSafeEqual(a, b);\n} catch (e) { validSig = false; }\nconst fresh = Number.isFinite(ts) && Math.abs(Date.now() - ts) < 5 * 60 * 1000;\nconst store = $getWorkflowStaticData('global');\nstore.seen = store.seen || {};\nconst duplicate = !!store.seen[body.eventId];\nconst validName = body.name === 'calendar.event_push';\nconst valid = !!secret && validSig && fresh && validName && !duplicate;\nif (valid) store.seen[body.eventId] = Date.now();\n\nconst d = body.data || {};\nreturn [{ json: { valid, duplicate, eventId: body.eventId, uid: d.uid, titulo: d.titulo, inicio: d.inicio, fin: d.fin, direccion: d.direccion || '' } }];"
      },
