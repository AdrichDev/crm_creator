    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\nconst secret = $env.AUTOMATION_WEBHOOK_SECRET || '';\nconst item = $input.all()[0].json;\nconst headers = item.headers || {};\nconst body = item.body || {};\nconst envelope = { eventId: body.eventId, name: body.name, businessId: body.businessId, occurredAt: body.occurredAt, data: body.data };\nconst rawBody = JSON.stringify(envelope);\nconst ts = Number(headers['x-automation-timestamp']);\nconst sig = String(headers['x-automation-signature'] || '');\nlet validSig = false;\ntry {\n  const expected = crypto.createHmac('sha256', secret).update(`${ts}.${rawBody}`).digest('hex');\n  const a = Buffer.from(expected, 'hex');\n  const b = Buffer.from(sig, 'hex');\n  validSig = a.length === b.length && crypto.timingSafeEqual(a, b);\n} catch (e) { validSig = false; }\nconst fresh = Number.isFinite(ts) && Math.abs(Date.now() - ts) < 5 * 60 * 1000;\nconst store = $getWorkflowStaticData('global');\nstore.seen = store.seen || {};\nconst duplicate = !!store.seen[body.eventId];\nlet route;\nif (!secret || !validSig || !fresh) route = 'auth_failed';\nelse if (duplicate) route = 'duplicate';\nelse { store.seen[body.eventId] = Date.now(); route = body.name; }\n\n// Helpers de presentacion: branding por cliente + fecha legible.\nconst d = body.data || {};\nconst br = d.branding || {};\nconst primary = br.primary || '#4f46e5';\nconst secondary = br.secondary || primary;\nlet logoHtml;\nif (br.logoImage) {\n  logoHtml = `<img src=\"${br.logoImage}\" alt=\"${d.businessName || ''}\" height=\"44\" style=\"height:44px;border-radius:8px\"/>`;\n} else {\n  const txt = String(br.logoText || (d.businessName || '').slice(0, 2) || 'OK').toUpperCase();\n  logoHtml = `<div style=\"display:inline-block;width:48px;height:48px;line-height:48px;border-radius:12px;color:#fff;font-weight:700;font-size:18px;background:linear-gradient(135deg,${primary},${secondary})\">${txt}</div>`;\n}\nlet expiresHuman = d.expiresAt || '';\ntry {\n  const dt = new Date(d.expiresAt);\n  if (!isNaN(dt.getTime())) {\n    const p = (n) => String(n).padStart(2, '0');\n    expiresHuman = `${p(dt.getDate())}/${p(dt.getMonth() + 1)}/${dt.getFullYear()} ${p(dt.getHours())}:${p(dt.getMinutes())}`;\n  }\n} catch (e) {}\n\nreturn [{ json: { route, eventId: body.eventId, businessId: body.businessId, name: body.name, data: body.data, primary, secondary, logoHtml, expiresHuman } }];"
      },
