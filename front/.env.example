# front/.env.example — contrato COMPLETO de variables consumibles por el front.
# Ver docs/ENV-CONTRACT.md para el modelo de tiers (quien aloja que). Solo
# placeholders: nunca valores reales, ni siquiera los del tenant exportado.

# --- Plataforma (crm-export-runtime-config) ---
# Cablean el ZIP exportado al backend de plataforma (/tenant-config, kill
# switch). Reservadas: solo aplican si el despliegue sigue conectado a la
# plataforma del operador (tier 1/2, u opcional en tier 3).
PLATFORM_API_URL=            # URL del backend de plataforma
TENANT_ID=                   # identificador del negocio ante la plataforma
TENANT_API_KEY=              # clave portadora emitida por el operador

# --- API propia ---
NEXT_PUBLIC_API_URL=         # URL del backend (propio o del operador), si existe

# --- Terceros (claves publicas, restringir por referrer/origen) ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=   # obligatoria si la app usa mapas (front/lib/maps/loader.ts lanza si falta)

# --- Supabase (solo si el despliegue consume Supabase directamente desde el front) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Identidad de negocio (opcional) ---
NEXT_PUBLIC_BUSINESS_ID=     # tenant activo por defecto en desarrollo, hasta tener auth/login real

# --- Build ---
NEXT_OUTPUT_MODE=            # 'export' (estatico) u otro modo soportado por next.config.ts; vacio = default

# --- Integracion interna operador (Agente Operador / Telegram, agents-agency) ---
# Solo relevante si este despliegue mantiene la integracion con el Operador del
# operador de plataforma; no forma parte del contrato tenant-facing.
AA_API_URL=                  # URL del backend de agents-agency
AA_SERVICE_TOKEN=            # token de servicio (Authorization: Bearer)

CRM_API_URL= # Base URL del back del CRM (raiz, sin /api). Si vacia, usa NEXT_PUBLIC_API_URL. Solo servidor.
OPERATOR_SERVICE_TOKEN= # Service token del proxy operador server-side hacia /service/operator. NUNCA NEXT_PUBLIC_.

# --- Desarrollo y e2e (nunca en despliegue) ---
NEXT_DIST_DIR=               # directorio de build alternativo; un dev efimero para e2e escribe aqui y no pisa .next
E2E_BASE_URL=                # servidor ya levantado contra el que corre Playwright; si esta, no arranca uno propio
E2E_EMAIL=                   # usuario con acceso al proyecto de pruebas; sin el, los e2e autenticados se saltan
E2E_PASSWORD=                # nunca se commitea (front/e2e/_auth.ts)
E2E_API_URL=                 # back contra el que preparan y limpian los specs (por defecto http://localhost:4001)
E2E_PROJECT=                 # nombre del negocio que abren los specs (por defecto Estudio Lua)
