# Supabase — rellena cuando tengas el proyecto creado.
# Mientras estas variables estén vacías, la app usa datos locales (localStorage).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# (Opcional) tenant activo por defecto en desarrollo, hasta tener auth/login real.
NEXT_PUBLIC_DEFAULT_TENANT_ID=

# Backend OperaOS (Express/Prisma). Si se define, el front usa la API real.
NEXT_PUBLIC_API_URL=

# --- Postgres del CRM (docker-compose.yml → servicio db-crm) ---
# Cada proyecto nuevo crea su propio SCHEMA en esta base de datos.
# Si defines CRM_DATABASE_URL tiene prioridad sobre las variables sueltas.
# CRM_DATABASE_URL=postgresql://crm_admin:crm_password_seguro@localhost:5434/crm_production
PGHOST=localhost
PGPORT=5434
PGUSER=crm_admin
PGPASSWORD=crm_password_seguro
PGDATABASE=crm_production
