# Supabase — rellena cuando tengas el proyecto creado.
# Mientras estas variables estén vacías, la app usa datos locales (localStorage).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# (Opcional) tenant activo por defecto en desarrollo, hasta tener auth/login real.
NEXT_PUBLIC_DEFAULT_TENANT_ID=

# Backend OperaOS (Express/Prisma). Si se define, el front usa la API real.
NEXT_PUBLIC_API_URL=
