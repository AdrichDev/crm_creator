// OperaOS — Business OS para negocios locales. Multi-tenant (businessId en todo).
// NOMENCLATURA DB (2026-06): tablas y columnas físicas en castellano snake_case vía
// @@map/@map. Los NOMBRES de modelo y de campo en Prisma se mantienen en inglés para
// no romper el API de Prisma Client (src/ y tests usan prisma.business, .firstName, …).
// @@map/@map afectan SOLO al SQL físico, no al cliente JS. Enums: VALUES intactos
// (RLS depende de role<>'CLIENT').
generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------- Enums -----------------------------
enum MemberRole {
  OWNER
  ADMIN
  MANAGER
  EMPLOYEE
  RECEPTIONIST
  PROFESSIONAL
  ACCOUNTANT
  CLIENT
}

enum ResourceType {
  TABLE
  ROOM
  CABIN
  CHAIR
  BED
  MACHINE
  CLASS_SLOT
  TRAINER
  COURT
  SPACE
  OTHER
}

enum BookingStatus {
  DRAFT
  PENDING
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum BookingChannel {
  MANUAL
  ONLINE
}

enum TimeOffStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum TimeOffType {
  VACATION
  SICK
  LEAVE
  OTHER
}

enum DocumentType {
  PAYROLL
  CONTRACT
  CERTIFICATE
  INTERNAL
  OTHER
}

enum DocVisibility {
  OWNER_ONLY
  LOCATION
  BUSINESS
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  LEAD
}

enum PackageStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  AUTOMATIC
  FINISHED
}

// ----------------------------- Núcleo -----------------------------
model Business {
  id              String   @id @default(cuid())
  // FK cross-schema → aa.tenant.id (el "cliente general" que contrata la plataforma).
  // 1:1 con Tenant. La constraint FK se aplica por SQL (Prisma no modela relaciones
  // cross-schema sin multiSchema; ver migración add-tenant-fk.sql).
  tenantId        String?  @unique @map("tenant_id")
  name            String   @map("nombre")
  legalName       String?  @map("razon_social")
  taxId           String?  @map("nif")
  vertical        String   @default("custom") @map("vertical")
  defaultCurrency String   @default("EUR") @map("moneda")
  defaultTimezone String   @default("Europe/Madrid") @map("zona_horaria")
  plan            String   @default("starter") @map("plan")
  brandPrimary    String   @default("#1b431c") @map("marca_primario")
  brandSecondary  String   @default("#8cc63f") @map("marca_secundario")
  logoUrl         String?  @map("logo_url") // URL pública en Supabase Storage (bucket 'branding'); usada en emails
  createdAt       DateTime @default(now()) @map("creado_en")
  updatedAt       DateTime @updatedAt @map("actualizado_en")

  locations    Location[]
  memberships  Membership[]
  employees    Employee[]
  customers    Customer[]
  services     Service[]
  resources    Resource[]
  bookings     Booking[]
  tags         Tag[]
  timeOff      TimeOffRequest[]
  documents    Document[]
  packages     Package[]
  customerPkgs CustomerPackage[]
  products     Product[]
  sales        Sale[]
  campaigns    Campaign[]
  fichajes     Fichaje[]
  settings     BusinessSetting[]
  notifications Notification[]
  invoices     Invoice[]

  @@map("negocio")
}

model Location {
  id        String   @id @default(cuid())
  businessId String  @map("negocio_id")
  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name      String   @map("nombre")
  address   String?  @map("direccion")
  timezone  String   @default("Europe/Madrid") @map("zona_horaria")
  currency  String   @default("EUR") @map("moneda")
  phone     String?  @map("telefono")
  email     String?  @map("email")
  onlineBookingEnabled Boolean @default(true) @map("reserva_online_activa")
  active    Boolean  @default(true) @map("activo")
  createdAt DateTime @default(now()) @map("creado_en")
  updatedAt DateTime @updatedAt @map("actualizado_en")

  openingHours OpeningHour[]
  holidays     Holiday[]
  employees    Employee[]
  resources    Resource[]
  bookings     Booking[]
  @@index([businessId])
  @@map("sucursal")
}

model BusinessSetting {
  id         String   @id @default(cuid())
  businessId String   @map("negocio_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  locationId String?  @map("sucursal_id")
  category   String   @map("categoria")
  data       Json     @default("{}") @map("datos")
  updatedAt  DateTime @updatedAt @map("actualizado_en")
  @@unique([businessId, locationId, category])
  @@map("config_negocio")
}

model OpeningHour {
  id         String   @id @default(cuid())
  locationId String   @map("sucursal_id")
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  weekday    Int      @map("dia_semana") // 0=domingo .. 6=sábado
  openTime   String   @map("hora_apertura") // "09:00"
  closeTime  String   @map("hora_cierre") // "20:00"
  @@index([locationId, weekday])
  @@map("horario_apertura")
}

model Holiday {
  id         String   @id @default(cuid())
  locationId String   @map("sucursal_id")
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date @map("fecha")
  name       String?  @map("nombre")
  isOpen     Boolean  @default(false) @map("abierto")
  @@index([locationId, date])
  @@map("festivo")
}

model User {
  // id = auth.users.id (UUID from Supabase Auth). No app-side ID generation.
  id          String   @id @db.Uuid
  email       String   @unique @map("email")
  // Handle único del cliente (auto-registro). Opcional para staff invitado.
  username    String?  @unique @map("usuario_handle")
  phone       String?  @map("telefono")
  firstName   String   @map("nombre")
  lastName    String?  @map("apellido")
  createdAt   DateTime @default(now()) @map("creado_en")
  memberships Membership[]
  employee    Employee?
  customers   Customer[]
  @@map("usuario")
}

model Membership {
  id         String     @id @default(cuid())
  userId     String     @db.Uuid @map("usuario_id")
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String     @map("negocio_id")
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  locationId String?    @map("sucursal_id")
  role       MemberRole @default(EMPLOYEE) @map("rol")
  createdAt  DateTime   @default(now()) @map("creado_en")
  @@unique([userId, businessId])
  @@index([userId, businessId])
  @@index([businessId])
  @@map("membresia")
}

// ----------------------------- Personas / catálogo -----------------------------
model Employee {
  id           String   @id @default(cuid())
  businessId   String   @map("negocio_id")
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  locationId   String?  @map("sucursal_id")
  location     Location? @relation(fields: [locationId], references: [id])
  userId       String?  @unique @db.Uuid @map("usuario_id")
  user         User?    @relation(fields: [userId], references: [id])
  firstName    String   @map("nombre")
  lastName     String?  @map("apellido")
  email        String?  @map("email")
  phone        String?  @map("telefono")
  specialty    String?  @map("especialidad")
  color        String   @default("#6366f1") @map("color")
  status       String   @default("Activo") @map("estado")
  hireDate     DateTime? @map("fecha_alta")
  vacationTotal Int     @default(22) @map("vacaciones_total")
  vacationUsed  Int     @default(0) @map("vacaciones_usadas")
  commission   Decimal? @map("comision")
  createdAt    DateTime @default(now()) @map("creado_en")
  updatedAt    DateTime @updatedAt @map("actualizado_en")

  services   Service[]        @relation("EmpServices")
  resources  Resource[]       @relation("ResEmployees")
  schedules  EmployeeSchedule[]
  bookings   Booking[]
  timeOff    TimeOffRequest[]
  documents  Document[]
  fichajes   Fichaje[]
  @@index([businessId])
  @@index([locationId])
  @@map("empleado")
}

model EmployeeSchedule {
  id         String   @id @default(cuid())
  employeeId String   @map("empleado_id")
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  weekday    Int      @map("dia_semana")
  startTime  String   @map("hora_inicio")
  endTime    String   @map("hora_fin")
  @@index([employeeId, weekday])
  @@map("horario_empleado")
}

model Customer {
  id          String   @id @default(cuid())
  businessId  String   @map("negocio_id")
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // userId links a self-registered CLIENT to their auth.users UUID (Q-A resolution).
  // Null for customers created manually by staff (no portal login).
  userId      String?  @unique @db.Uuid @map("usuario_id")
  user        User?    @relation(fields: [userId], references: [id])
  firstName   String   @map("nombre")
  lastName    String?  @map("apellido")
  phone       String?  @map("telefono")
  email       String?  @map("email")
  birthDate   DateTime? @map("fecha_nacimiento")
  gender      String?  @map("genero")
  address     String?  @map("direccion")
  acquisitionChannel String? @map("canal_captacion")
  notes       String?  @map("notas")
  preferences Json     @default("{}") @map("preferencias")
  consentComms Boolean @default(false) @map("consentimiento_comms")
  consentAt   DateTime? @map("consentimiento_en")
  status      CustomerStatus @default(ACTIVE) @map("estado")
  createdAt   DateTime @default(now()) @map("creado_en")
  updatedAt   DateTime @updatedAt @map("actualizado_en")

  tags        Tag[]            @relation("CustomerTags")
  bookings    Booking[]
  packages    CustomerPackage[]
  sales       Sale[]
  @@index([businessId])
  @@index([businessId, phone])
  @@index([businessId, email])
  @@map("cliente")
}

model Tag {
  id         String   @id @default(cuid())
  businessId String   @map("negocio_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String   @map("nombre")
  color      String   @default("#9ca3af") @map("color")
  customers  Customer[] @relation("CustomerTags")
  @@index([businessId])
  @@map("etiqueta")
}

model Service {
  id          String   @id @default(cuid())
  businessId  String   @map("negocio_id")
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String   @map("nombre")
  description String?  @map("descripcion")
  category    String?  @map("categoria")
  durationMin Int      @default(30) @map("duracion_min")
  price       Decimal  @default(0) @map("precio")
  tax         Decimal? @map("impuesto")
  requiresResource Boolean @default(false) @map("requiere_recurso")
  resourceType ResourceType? @map("tipo_recurso")
  requiresProfessional Boolean @default(true) @map("requiere_profesional")
  onlineBookable Boolean @default(true) @map("reservable_online")
  color       String   @default("#1b431c") @map("color")
  bufferBefore Int     @default(0) @map("margen_antes")
  bufferAfter  Int     @default(0) @map("margen_despues")
  requiresConsent Boolean @default(false) @map("requiere_consentimiento")
  requiresPackage Boolean @default(false) @map("requiere_bono")
  active      Boolean  @default(true) @map("activo")
  createdAt   DateTime @default(now()) @map("creado_en")
  updatedAt   DateTime @updatedAt @map("actualizado_en")

  employees   Employee[] @relation("EmpServices")
  resources   Resource[] @relation("ResServices")
  bookings    Booking[]
  packages    Package[]  @relation("PackageServices")
  @@index([businessId])
  @@map("servicio")
}

model Resource {
  id          String   @id @default(cuid())
  businessId  String   @map("negocio_id")
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  locationId  String?  @map("sucursal_id")
  location    Location? @relation(fields: [locationId], references: [id])
  name        String   @map("nombre")
  type        ResourceType @default(OTHER) @map("tipo")
  capacity    Int      @default(1) @map("capacidad")
  status      String   @default("Activo") @map("estado")
  locationNote String? @map("nota_ubicacion")
  description String?  @map("descripcion")
  metadata    Json     @default("{}") @map("metadatos")
  createdAt   DateTime @default(now()) @map("creado_en")
  updatedAt   DateTime @updatedAt @map("actualizado_en")

  services    Service[]  @relation("ResServices")
  employees   Employee[] @relation("ResEmployees")
  bookings    Booking[]  @relation("BookingResources")
  @@index([businessId])
  @@index([locationId, type])
  @@map("recurso")
}

// ----------------------------- Reservas -----------------------------
model Booking {
  id          String   @id @default(cuid())
  businessId  String   @map("negocio_id")
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  locationId  String   @map("sucursal_id")
  location    Location @relation(fields: [locationId], references: [id])
  customerId  String?  @map("cliente_id")
  customer    Customer? @relation(fields: [customerId], references: [id])
  serviceId   String   @map("servicio_id")
  service     Service  @relation(fields: [serviceId], references: [id])
  employeeId  String?  @map("empleado_id")
  employee    Employee? @relation(fields: [employeeId], references: [id])
  startAt     DateTime @map("inicia_en")
  endAt       DateTime @map("termina_en")
  status      BookingStatus @default(PENDING) @map("estado")
  channel     BookingChannel @default(MANUAL) @map("canal")
  notes       String?  @map("notas")
  createdById String?  @map("creado_por")
  createdAt   DateTime @default(now()) @map("creado_en")
  updatedAt   DateTime @updatedAt @map("actualizado_en")

  resources   Resource[] @relation("BookingResources")
  history     BookingStatusHistory[]
  sessions    PackageSession[]
  @@index([businessId])
  @@index([locationId, startAt])
  @@index([employeeId, startAt])
  @@index([customerId])
  @@index([status])
  @@map("reserva")
}

model BookingStatusHistory {
  id         String   @id @default(cuid())
  bookingId  String   @map("reserva_id")
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fromStatus BookingStatus? @map("estado_anterior")
  toStatus   BookingStatus  @map("estado_nuevo")
  changedBy  String?  @map("cambiado_por")
  changedAt  DateTime @default(now()) @map("cambiado_en")
  reason     String?  @map("motivo")
  @@index([bookingId, changedAt])
  @@map("historial_estado_reserva")
}

// ----------------------------- Vacaciones / documentos / bonos -----------------------------
model TimeOffRequest {
  id          String   @id @default(cuid())
  businessId  String   @map("negocio_id")
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employeeId  String   @map("empleado_id")
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type        TimeOffType @default(VACATION) @map("tipo")
  startDate   DateTime @db.Date @map("fecha_inicio")
  endDate     DateTime @db.Date @map("fecha_fin")
  days        Int?     @map("dias")
  status      TimeOffStatus @default(PENDING) @map("estado")
  reason      String?  @map("motivo")
  decidedBy   String?  @map("decidido_por")
  decidedAt   DateTime? @map("decidido_en")
  createdAt   DateTime @default(now()) @map("creado_en")
  @@index([employeeId, startDate])
  @@map("solicitud_ausencia")
}

model Document {
  id          String   @id @default(cuid())
  businessId  String   @map("negocio_id")
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employeeId  String?  @map("empleado_id")
  employee    Employee? @relation(fields: [employeeId], references: [id])
  title       String   @map("titulo")
  type        DocumentType @default(OTHER) @map("tipo")
  filePath    String   @map("ruta_archivo")
  visibility  DocVisibility @default(OWNER_ONLY) @map("visibilidad")
  uploadedBy  String?  @map("subido_por")
  createdAt   DateTime @default(now()) @map("creado_en")
  @@index([businessId])
  @@index([employeeId])
  @@map("documento")
}

model Package {
  id           String   @id @default(cuid())
  businessId   String   @map("negocio_id")
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String   @map("nombre")
  sessionsTotal Int     @map("sesiones_total")
  validityDays Int      @default(365) @map("validez_dias")
  price        Decimal? @map("precio")
  active       Boolean  @default(true) @map("activo")
  createdAt    DateTime @default(now()) @map("creado_en")
  services     Service[] @relation("PackageServices")
  instances    CustomerPackage[]
  @@index([businessId])
  @@map("paquete")
}

model CustomerPackage {
  id          String   @id @default(cuid())
  businessId  String   @map("negocio_id")
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId  String   @map("cliente_id")
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  packageId   String   @map("paquete_id")
  package     Package  @relation(fields: [packageId], references: [id])
  sessionsTotal Int    @map("sesiones_total")
  sessionsUsed Int     @default(0) @map("sesiones_usadas")
  purchasedAt DateTime @default(now()) @map("comprado_en")
  expiresAt   DateTime? @map("expira_en")
  status      PackageStatus @default(ACTIVE) @map("estado")
  sessions    PackageSession[]
  @@index([customerId])
  @@map("paquete_cliente")
}

model PackageSession {
  id               String   @id @default(cuid())
  customerPackageId String   @map("paquete_cliente_id")
  customerPackage  CustomerPackage @relation(fields: [customerPackageId], references: [id], onDelete: Cascade)
  bookingId        String?  @map("reserva_id")
  booking          Booking? @relation(fields: [bookingId], references: [id])
  usedAt           DateTime @default(now()) @map("usado_en")
  note             String?  @map("nota")
  @@index([customerPackageId])
  @@map("sesion_paquete")
}

// ----------------------------- Servicios existentes (retail / personas / marketing) -----------------------------
model Product {
  id          String   @id @default(cuid())
  businessId  String   @map("negocio_id")
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String   @map("nombre")
  category    String?  @map("categoria")
  stock       Int      @default(0) @map("stock")
  stockMinimo Int      @default(0) @map("stock_minimo")
  price       Decimal  @default(0) @map("precio")
  supplier    String?  @map("proveedor")
  createdAt   DateTime @default(now()) @map("creado_en")
  updatedAt   DateTime @updatedAt @map("actualizado_en")
  @@index([businessId])
  @@map("producto")
}

model Sale {
  id          String   @id @default(cuid())
  businessId  String   @map("negocio_id")
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId  String?  @map("cliente_id")
  customer    Customer? @relation(fields: [customerId], references: [id])
  customerName String? @default("Contado") @map("cliente_nombre")
  date        DateTime @default(now()) @map("fecha")
  paymentMethod String @default("Tarjeta") @map("metodo_pago")
  total       Decimal  @default(0) @map("total")
  createdAt   DateTime @default(now()) @map("creado_en")
  lines       SaleLine[]
  @@index([businessId])
  @@map("venta")
}

model SaleLine {
  id        String   @id @default(cuid())
  saleId    String   @map("venta_id")
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  concept   String   @map("concepto")
  quantity  Int      @default(1) @map("cantidad")
  unitPrice Decimal  @default(0) @map("precio_unitario")
  subtotal  Decimal  @default(0) @map("subtotal")
  @@index([saleId])
  @@map("linea_venta")
}

// Facturación. Espejo del tipo `Factura` del front del CRM (creador_CRM/front).
// `documentos` guarda los adjuntos (incl. data URL para previsualizar) como JSON.
model Invoice {
  id         String   @id @default(cuid())
  businessId String   @map("negocio_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  numero     String   @map("numero")
  cliente    String   @map("cliente_nombre")
  servicio   String?  @map("servicio_nombre")
  fecha      String   @map("fecha")
  total      Decimal  @default(0) @map("total")
  estado     String   @default("Pendiente") @map("estado")
  documentos Json?    @map("documentos")
  createdAt  DateTime @default(now()) @map("creado_en")
  @@index([businessId])
  @@map("factura")
}

model Campaign {
  id         String   @id @default(cuid())
  businessId String   @map("negocio_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String   @map("nombre")
  channel    String   @default("Email") @map("canal")
  status     CampaignStatus @default(DRAFT) @map("estado")
  sent       Int      @default(0) @map("enviados")
  opens      String?  @map("aperturas")
  createdAt  DateTime @default(now()) @map("creado_en")
  updatedAt  DateTime @updatedAt @map("actualizado_en")
  @@index([businessId])
  @@map("campana")
}

model Fichaje {
  id          String   @id @default(cuid())
  businessId  String   @map("negocio_id")
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employeeId  String?  @map("empleado_id")
  employee    Employee? @relation(fields: [employeeId], references: [id])
  employeeName String? @map("empleado_nombre")
  date        DateTime @default(now()) @db.Date @map("fecha")
  checkIn     DateTime? @map("entrada")
  checkOut    DateTime? @map("salida")
  hours       Decimal? @map("horas")
  createdAt   DateTime @default(now()) @map("creado_en")
  @@index([businessId])
  @@map("fichaje")
}

// ----------------------------- Plataforma -----------------------------
model Notification {
  id          String   @id @default(cuid())
  businessId  String   @map("negocio_id")
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type        String   @map("tipo")
  channel     String   @default("email") @map("canal")
  target      String?  @map("destino")
  payload     Json     @default("{}") @map("payload")
  scheduledAt DateTime? @map("programado_en")
  sentAt      DateTime? @map("enviado_en")
  status      String   @default("pending") @map("estado")
  createdAt   DateTime @default(now()) @map("creado_en")
  @@index([scheduledAt, status])
  @@map("notificacion")
}
