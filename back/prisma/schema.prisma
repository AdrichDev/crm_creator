// OperaOS — Business OS para negocios locales. Multi-tenant (businessId en todo).
// NOMENCLATURA (2026-06): columnas físicas en castellano snake_case vía @@map/@map.
// Los CAMPOS Prisma están castellanizados (P.7) en TODOS los modelos: Customer, Service,
// Product, Employee, Booking, Sale/SaleLine, Campaign, Fichaje, Business, Location, Resource,
// Tag, Package, CustomerPackage, TimeOffRequest, Holiday, OpeningHour, BookingStatusHistory,
// PackageSession, Document, Notification, EmployeeSchedule, BusinessSetting.
// NOMBRES de MODELO en inglés (prisma.business, .customer…) — no se tocan.
// EXCEPCIONES que se quedan en inglés (infra/auth, invisibles al usuario): tenant/tenant_id,
// id, FKs *Id, createdAt/updatedAt, logoUrl, vertical, plan, Membership.role (enum permisos,
// usado en rbac), User.firstName/lastName/email/username/phone (auth, acoplado al front
// gestión-usuarios). Enums: VALUES intactos (RLS depende de role<>'CLIENT').
generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated/prisma"
}
datasource db {
  provider = "postgresql"
  // P7: la URL de conexión vive en prisma.config.ts (Migrate) y se pasa vía
  // driver-adapter (@prisma/adapter-pg) al construir PrismaClient (runtime).
}

// ----------------------------- Enums -----------------------------
enum MemberRole {
  ADMIN
  MANAGER
  EMPLOYEE
  CLIENT
}

// Servicios de integración externos (crm-integraciones-comunicacion).
// gmail/calendar = OAuth2 real; whatsapp = marcador de estado (secreto Twilio vive en n8n).
enum ServicioIntegracion {
  gmail
  whatsapp
  calendar
}

enum ResourceType {
  TABLE
  ROOM
  CABIN
  CHAIR
  BED
  MACHINE
  CLASS_SLOT
  TRAINER
  COURT
  SPACE
  OTHER
}

enum BookingStatus {
  DRAFT
  PENDING
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum BookingChannel {
  MANUAL
  ONLINE
}

enum TimeOffStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum TimeOffType {
  VACATION
  SICK
  LEAVE
  OTHER
}

enum DocumentType {
  PAYROLL
  CONTRACT
  CERTIFICATE
  INTERNAL
  OTHER
}

enum DocVisibility {
  OWNER_ONLY
  LOCATION
  BUSINESS
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  LEAD
}

// Comercial de campo (crm-comercial-campo)
enum GeoStatus {
  PENDING
  OK
  FAILED
}

enum AbcCategory {
  A
  B
  C
}

enum RegistroType {
  CLIENTE
  PROSPECTO
}

enum NoteOrigin {
  MANUAL
  AUDIO
  IMPORT
}

enum ReminderStatus {
  PENDING
  DONE
  CANCELLED
}

enum PackageStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  AUTOMATIC
  FINISHED
}

enum DeporteType {
  FUTBOL_11
  FUTBOL_7
  FUTBOL_SALA
  BALONCESTO
  NATACION
  HALTEROFILIA
  OTRO
}

// ----------------------------- Núcleo -----------------------------
model Business {
  id              String   @id @default(cuid())
  // FK cross-schema → aa.tenant.id (el "cliente general" que contrata la plataforma).
  // 1:1 con Tenant. La constraint FK se aplica por SQL (Prisma no modela relaciones
  // cross-schema sin multiSchema; ver migración add-tenant-fk.sql).
  tenantId        String?  @map("tenant_id")
  nombre          String   @map("nombre")
  razonSocial     String?  @map("razon_social")
  nif             String?  @map("nif")
  vertical        String   @default("custom") @map("vertical")
  moneda          String   @default("EUR") @map("moneda")
  zonaHoraria     String   @default("Europe/Madrid") @map("zona_horaria")
  plan            String   @default("starter") @map("plan")
  marcaPrimario   String   @default("#1b431c") @map("marca_primario")
  marcaSecundario String   @default("#8cc63f") @map("marca_secundario")
  logoUrl         String?  @map("logo_url") // URL pública en Supabase Storage (bucket 'branding'); usada en emails
  eliminadoEn     DateTime? @map("eliminado_en") // soft delete: null = activo; fecha = borrado (hard delete en prod)
  generadoEn      DateTime? @map("generado_en") // null = solo configurado; fecha = paquete del proyecto ya generado
  createdAt       DateTime @default(now()) @map("creado_en")
  updatedAt       DateTime @updatedAt @map("actualizado_en")

  locations    Location[]
  memberships  Membership[]
  employees    Employee[]
  customers    Customer[]
  services     Service[]
  resources    Resource[]
  bookings     Booking[]
  tags         Tag[]
  timeOff      TimeOffRequest[]
  documents    Document[]
  packages     Package[]
  customerPkgs CustomerPackage[]
  products     Product[]
  sales        Sale[]
  campaigns    Campaign[]
  fichajes     Fichaje[]
  workdayEvents WorkdayEvent[]
  settings     BusinessSetting[]
  notifications Notification[]
  invoices     Invoice[]
  pedidos      Pedido[]
  teams        Team[]
  visitStates  VisitState[]
  visits       Visit[]
  customerNotes CustomerNote[]
  reminders    Reminder[]
  oauthCredentials OAuthCredential[]
  contactos    Contacto[]
  telegramMessages TelegramMessage[]

  @@map("negocio")
}

model Location {
  id        String   @id @default(cuid())
  businessId String  @map("negocio_id")
  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  nombre    String   @map("nombre")
  direccion String?  @map("direccion")
  zonaHoraria String @default("Europe/Madrid") @map("zona_horaria")
  moneda    String   @default("EUR") @map("moneda")
  telefono  String?  @map("telefono")
  email     String?  @map("email")
  reservaOnline Boolean @default(true) @map("reserva_online_activa")
  activo    Boolean  @default(true) @map("activo")
  createdAt DateTime @default(now()) @map("creado_en")
  updatedAt DateTime @updatedAt @map("actualizado_en")

  openingHours OpeningHour[]
  holidays     Holiday[]
  employees    Employee[]
  resources    Resource[]
  bookings     Booking[]
  @@index([businessId])
  eliminadoEn DateTime? @map("eliminado_en")
  @@map("sucursal")
}

model BusinessSetting {
  id         String   @id @default(cuid())
  businessId String   @map("negocio_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  locationId String?  @map("sucursal_id")
  categoria  String   @map("categoria")
  datos      Json     @default("{}") @map("datos")
  updatedAt  DateTime @updatedAt @map("actualizado_en")
  @@unique([businessId, locationId, categoria])
  @@map("config_negocio")
}

model OpeningHour {
  id         String   @id @default(cuid())
  locationId String   @map("sucursal_id")
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  diaSemana  Int      @map("dia_semana") // 0=domingo .. 6=sábado
  apertura   String   @map("hora_apertura") // "09:00"
  cierre     String   @map("hora_cierre") // "20:00"
  @@index([locationId, diaSemana])
  @@map("horario_apertura")
}

model Holiday {
  id         String   @id @default(cuid())
  locationId String   @map("sucursal_id")
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  fecha      DateTime @db.Date @map("fecha")
  nombre     String?  @map("nombre")
  abierto    Boolean  @default(false) @map("abierto")
  @@index([locationId, fecha])
  @@map("festivo")
}

model User {
  // id = auth.users.id (UUID from Supabase Auth). No app-side ID generation.
  id          String   @id @db.Uuid
  email       String   @unique @map("email")
  // Handle único del cliente (auto-registro). Opcional para staff invitado.
  username    String?  @unique @map("usuario_handle")
  phone       String?  @map("telefono")
  firstName   String   @map("nombre")
  lastName    String?  @map("apellido")
  createdAt   DateTime @default(now()) @map("creado_en")
  // crm-citas-google-calendar: opt-in de push de citas/recordatorios a Google Calendar vía n8n.
  calendarPushEnabled Boolean @default(false) @map("calendario_push_habilitado")
  memberships Membership[]
  employee    Employee?
  customers   Customer[]
  calendarToken CalendarToken?
  @@map("usuario")
}

model Membership {
  id         String     @id @default(cuid())
  userId     String     @db.Uuid @map("usuario_id")
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String     @map("negocio_id")
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  locationId String?    @map("sucursal_id")
  role       MemberRole @default(EMPLOYEE) @map("rol")
  createdAt  DateTime   @default(now()) @map("creado_en")
  @@unique([userId, businessId])
  @@index([userId, businessId])
  @@index([businessId])
  @@map("membresia")
}

// ----------------------------- Personas / catálogo -----------------------------
model Employee {
  id           String   @id @default(cuid())
  businessId   String   @map("negocio_id")
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  locationId   String?  @map("sucursal_id")
  location     Location? @relation(fields: [locationId], references: [id])
  userId       String?  @unique @db.Uuid @map("usuario_id")
  user         User?    @relation(fields: [userId], references: [id])
  nombre       String   @map("nombre")
  apellido     String?  @map("apellido")
  email        String?  @map("email")
  telefono     String?  @map("telefono")
  especialidad String?  @map("especialidad")
  color        String   @default("#6366f1") @map("color")
  estado       String   @default("Activo") @map("estado")
  fechaAlta    DateTime? @map("fecha_alta")
  vacacionesTotal Int   @default(22) @map("vacaciones_total")
  vacacionesUsadas Int  @default(0) @map("vacaciones_usadas")
  comision     Decimal? @map("comision")
  rol          String?  @map("rol") // puesto del empleado (texto libre: Estilista, Recepción…), distinto de especialidad
  imagenUrl    String?  @map("imagen_url")
  createdAt    DateTime @default(now()) @map("creado_en")
  updatedAt    DateTime @updatedAt @map("actualizado_en")

  services   Service[]        @relation("EmpServices")
  resources  Resource[]       @relation("ResEmployees")
  schedules  EmployeeSchedule[]
  bookings   Booking[]
  timeOff    TimeOffRequest[]
  documents  Document[]
  fichajes     Fichaje[]
  workdayEvents WorkdayEvent[]
  teamMembers  TeamMember[]
  @@index([businessId])
  @@index([locationId])
  eliminadoEn DateTime? @map("eliminado_en")
  @@map("empleado")
}

model EmployeeSchedule {
  id         String   @id @default(cuid())
  employeeId String   @map("empleado_id")
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  diaSemana  Int      @map("dia_semana")
  inicio     String   @map("hora_inicio")
  fin        String   @map("hora_fin")
  @@index([employeeId, diaSemana])
  @@map("horario_empleado")
}

model Customer {
  id          String   @id @default(cuid())
  businessId  String   @map("negocio_id")
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  // userId links a self-registered CLIENT to their auth.users UUID (Q-A resolution).
  // Null for customers created manually by staff (no portal login).
  userId      String?  @unique @db.Uuid @map("usuario_id")
  user        User?    @relation(fields: [userId], references: [id])
  nombre      String   @map("nombre")
  apellido    String?  @map("apellido")
  // Empresa/razón social del cliente (crm-clientes-empresa-vs-contacto). Nullable/aditivo:
  // `nombre`+`apellido` siguen siendo la PERSONA de contacto, sin cambios.
  razonSocial String?  @map("razon_social")
  telefono    String?  @map("telefono")
  email       String?  @map("email")
  fechaNacimiento DateTime? @map("fecha_nacimiento")
  genero      String?  @map("genero")
  direccion   String?  @map("direccion")
  // Dirección estructurada (crm-operaos 9.2). Aditivos/nullable: `direccion` sigue siendo
  // la calle (con número embebido en filas antiguas); filas nuevas usan numero/piso aparte.
  numero      String?  @map("numero")
  piso        String?  @map("piso")
  imagenUrl   String?  @map("imagen_url")
  canalCaptacion String? @map("canal_captacion")
  notas       String?  @map("notas")
  preferencias Json    @default("{}") @map("preferencias")
  consentimientoComms Boolean @default(false) @map("consentimiento_comms")
  consentimientoEn DateTime? @map("consentimiento_en")
  estado      CustomerStatus @default(ACTIVE) @map("estado")
  // Comercial de campo (crm-comercial-campo). Todos aditivos/nullable → sin regresión.
  localidad    String?     @map("localidad")
  provincia    String?     @map("provincia")
  codigoPostal String?     @map("codigo_postal")
  latitud      Float?      @map("latitud")
  longitud     Float?      @map("longitud")
  geoEstado    GeoStatus   @default(PENDING) @map("geo_estado")
  categoriaAbc AbcCategory? @map("categoria_abc")
  estadoVisitaId String?   @map("estado_visita_id")
  estadoVisita VisitState? @relation(fields: [estadoVisitaId], references: [id], onDelete: SetNull)
  tipoRegistro RegistroType @default(CLIENTE) @map("tipo_registro")
  ultimaVisitaEn DateTime? @map("ultima_visita_en")
  proximaAccionEn DateTime? @map("proxima_accion_en")
  createdAt   DateTime @default(now()) @map("creado_en")
  updatedAt   DateTime @updatedAt @map("actualizado_en")

  tags        Tag[]            @relation("CustomerTags")
  bookings    Booking[]
  packages    CustomerPackage[]
  sales       Sale[]
  pedidos     Pedido[]
  teamMembers TeamMember[]
  historialNotas CustomerNote[]
  visitas     Visit[]
  recordatorios Reminder[]
  // Contactos comerciales (lead/prospecto) convertidos a este cliente (crm-operaos WU4).
  contactosOrigen Contacto[]
  @@index([businessId])
  @@index([businessId, telefono])
  @@index([businessId, email])
  @@index([businessId, estadoVisitaId])
  @@index([businessId, tipoRegistro])
  eliminadoEn DateTime? @map("eliminado_en")
  @@map("cliente")
}

model Tag {
  id         String   @id @default(cuid())
  businessId String   @map("negocio_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  nombre     String   @map("nombre")
  color      String   @default("#9ca3af") @map("color")
  customers  Customer[] @relation("CustomerTags")
  @@index([businessId])
  eliminadoEn DateTime? @map("eliminado_en")
  @@map("etiqueta")
}

model Service {
  id          String   @id @default(cuid())
  businessId  String   @map("negocio_id")
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  nombre      String   @map("nombre")
  descripcion String?  @map("descripcion")
  categoria   String?  @map("categoria")
  duracion    Int      @default(30) @map("duracion_min")
  precio      Decimal  @default(0) @map("precio")
  impuesto    Decimal? @map("impuesto")
  requiereRecurso Boolean @default(false) @map("requiere_recurso")
  tipoRecurso ResourceType? @map("tipo_recurso")
  requiereProfesional Boolean @default(true) @map("requiere_profesional")
  reservableOnline Boolean @default(true) @map("reservable_online")
  color       String   @default("#1b431c") @map("color")
  margenAntes Int      @default(0) @map("margen_antes")
  margenDespues Int    @default(0) @map("margen_despues")
  requiereConsentimiento Boolean @default(false) @map("requiere_consentimiento")
  requiereBono Boolean @default(false) @map("requiere_bono")
  imagenUrl   String?  @map("imagen_url")
  activo      Boolean  @default(true) @map("activo")
  createdAt   DateTime @default(now()) @map("creado_en")
  updatedAt   DateTime @updatedAt @map("actualizado_en")

  employees   Employee[] @relation("EmpServices")
  resources   Resource[] @relation("ResServices")
  bookings    Booking[]
  packages    Package[]  @relation("PackageServices")
  @@index([businessId])
  eliminadoEn DateTime? @map("eliminado_en")
  @@map("servicio")
}

model Resource {
  id          String   @id @default(cuid())
  businessId  String   @map("negocio_id")
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  locationId  String?  @map("sucursal_id")
  location    Location? @relation(fields: [locationId], references: [id])
  nombre      String   @map("nombre")
  tipo        ResourceType @default(OTHER) @map("tipo")
  capacidad   Int      @default(1) @map("capacidad")
  estado      String   @default("Activo") @map("estado")
  notaUbicacion String? @map("nota_ubicacion")
  descripcion String?  @map("descripcion")
  metadatos   Json     @default("{}") @map("metadatos")
  createdAt   DateTime @default(now()) @map("creado_en")
  updatedAt   DateTime @updatedAt @map("actualizado_en")

  services    Service[]  @relation("ResServices")
  employees   Employee[] @relation("ResEmployees")
  bookings    Booking[]  @relation("BookingResources")
  @@index([businessId])
  @@index([locationId, tipo])
  eliminadoEn DateTime? @map("eliminado_en")
  @@map("recurso")
}

// ----------------------------- Reservas -----------------------------
model Booking {
  id          String   @id @default(cuid())
  businessId  String   @map("negocio_id")
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  locationId  String   @map("sucursal_id")
  location    Location @relation(fields: [locationId], references: [id])
  customerId  String?  @map("cliente_id")
  customer    Customer? @relation(fields: [customerId], references: [id])
  // Reserva de equipo (entrenamiento): alternativa a customerId, XOR validado en el router.
  teamId      String?  @map("equipo_id")
  team        Team?    @relation(fields: [teamId], references: [id])
  serviceId   String   @map("servicio_id")
  service     Service  @relation(fields: [serviceId], references: [id])
  employeeId  String?  @map("empleado_id")
  employee    Employee? @relation(fields: [employeeId], references: [id])
  startAt     DateTime @map("inicia_en")
  endAt       DateTime @map("termina_en")
  status      BookingStatus @default(PENDING) @map("estado")
  channel     BookingChannel @default(MANUAL) @map("canal")
  notes       String?  @map("notas")
  createdById String?  @map("creado_por")
  createdAt   DateTime @default(now()) @map("creado_en")
  updatedAt   DateTime @updatedAt @map("actualizado_en")

  resources   Resource[] @relation("BookingResources")
  history     BookingStatusHistory[]
  sessions    PackageSession[]
  @@index([businessId])
  @@index([locationId, startAt])
  @@index([employeeId, startAt])
  @@index([customerId])
  @@index([teamId])
  @@index([status])
  eliminadoEn DateTime? @map("eliminado_en")
  @@map("reserva")
}

model BookingStatusHistory {
  id         String   @id @default(cuid())
  bookingId  String   @map("reserva_id")
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  estadoAnterior BookingStatus? @map("estado_anterior")
  estadoNuevo BookingStatus  @map("estado_nuevo")
  cambiadoPor String?  @map("cambiado_por")
  cambiadoEn  DateTime @default(now()) @map("cambiado_en")
  motivo     String?  @map("motivo")
  @@index([bookingId, cambiadoEn])
  @@map("historial_estado_reserva")
}

// ----------------------------- Vacaciones / documentos / bonos -----------------------------
model TimeOffRequest {
  id          String   @id @default(cuid())
  businessId  String   @map("negocio_id")
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employeeId  String   @map("empleado_id")
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  tipo        TimeOffType @default(VACATION) @map("tipo")
  inicio      DateTime @db.Date @map("fecha_inicio")
  fin         DateTime @db.Date @map("fecha_fin")
  dias        Int?     @map("dias")
  estado      TimeOffStatus @default(PENDING) @map("estado")
  motivo      String?  @map("motivo")
  decididoPor String?  @map("decidido_por")
  decididoEn  DateTime? @map("decidido_en")
  createdAt   DateTime @default(now()) @map("creado_en")
  @@index([employeeId, inicio])
  eliminadoEn DateTime? @map("eliminado_en")
  @@map("solicitud_ausencia")
}

model Document {
  id          String   @id @default(cuid())
  businessId  String   @map("negocio_id")
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employeeId  String?  @map("empleado_id")
  employee    Employee? @relation(fields: [employeeId], references: [id])
  titulo      String   @map("titulo")
  tipo        DocumentType @default(OTHER) @map("tipo")
  rutaArchivo String   @map("ruta_archivo")
  visibilidad DocVisibility @default(OWNER_ONLY) @map("visibilidad")
  subidoPor   String?  @map("subido_por")
  createdAt   DateTime @default(now()) @map("creado_en")
  @@index([businessId])
  @@index([employeeId])
  @@map("documento")
}

model Package {
  id           String   @id @default(cuid())
  businessId   String   @map("negocio_id")
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  nombre       String   @map("nombre")
  sesionesTotal Int     @map("sesiones_total")
  diasValidez  Int      @default(365) @map("validez_dias")
  precio       Decimal? @map("precio")
  activo       Boolean  @default(true) @map("activo")
  createdAt    DateTime @default(now()) @map("creado_en")
  services     Service[] @relation("PackageServices")
  instances    CustomerPackage[]
  @@index([businessId])
  eliminadoEn DateTime? @map("eliminado_en")
  @@map("paquete")
}

model CustomerPackage {
  id          String   @id @default(cuid())
  businessId  String   @map("negocio_id")
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId  String   @map("cliente_id")
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  packageId   String   @map("paquete_id")
  package     Package  @relation(fields: [packageId], references: [id])
  sesionesTotal Int   @map("sesiones_total")
  sesionesUsadas Int  @default(0) @map("sesiones_usadas")
  compradoEn  DateTime @default(now()) @map("comprado_en")
  expiraEn    DateTime? @map("expira_en")
  estado      PackageStatus @default(ACTIVE) @map("estado")
  sessions    PackageSession[]
  @@index([customerId])
  @@map("paquete_cliente")
}

model PackageSession {
  id               String   @id @default(cuid())
  customerPackageId String   @map("paquete_cliente_id")
  customerPackage  CustomerPackage @relation(fields: [customerPackageId], references: [id], onDelete: Cascade)
  bookingId        String?  @map("reserva_id")
  booking          Booking? @relation(fields: [bookingId], references: [id])
  usadoEn          DateTime @default(now()) @map("usado_en")
  nota             String?  @map("nota")
  @@index([customerPackageId])
  @@map("sesion_paquete")
}

// ----------------------------- Servicios existentes (retail / personas / marketing) -----------------------------
model Product {
  id          String   @id @default(cuid())
  businessId  String   @map("negocio_id")
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  nombre      String   @map("nombre")
  categoria   String?  @map("categoria")
  stock       Int      @default(0) @map("stock")
  minimo      Int      @default(0) @map("stock_minimo")
  precio      Decimal  @default(0) @map("precio")
  proveedor   String?  @map("proveedor")
  imagenUrl   String?  @map("imagen_url")
  createdAt   DateTime @default(now()) @map("creado_en")
  updatedAt   DateTime @updatedAt @map("actualizado_en")
  @@index([businessId])
  eliminadoEn DateTime? @map("eliminado_en")
  @@map("producto")
}

model Sale {
  id          String   @id @default(cuid())
  businessId  String   @map("negocio_id")
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId  String?  @map("cliente_id")
  customer    Customer? @relation(fields: [customerId], references: [id])
  cliente     String? @default("Contado") @map("cliente_nombre")
  fecha       DateTime @default(now()) @map("fecha")
  metodo      String   @default("Tarjeta") @map("metodo_pago")
  total       Decimal  @default(0) @map("total")
  createdAt   DateTime @default(now()) @map("creado_en")
  lines       SaleLine[]
  @@index([businessId])
  eliminadoEn DateTime? @map("eliminado_en")
  @@map("venta")
}

model SaleLine {
  id        String   @id @default(cuid())
  saleId    String   @map("venta_id")
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  concepto  String   @map("concepto")
  cantidad  Int      @default(1) @map("cantidad")
  precioUnitario Decimal @default(0) @map("precio_unitario")
  subtotal  Decimal  @default(0) @map("subtotal")
  @@index([saleId])
  @@map("linea_venta")
}

// Facturación. Espejo del tipo `Factura` del front del CRM (creador_CRM/front).
// `documentos` guarda los adjuntos (incl. data URL para previsualizar) como JSON.
model Invoice {
  id         String   @id @default(cuid())
  businessId String   @map("negocio_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  numero     String   @map("numero")
  cliente    String   @map("cliente_nombre")
  servicio   String?  @map("servicio_nombre")
  fecha      String   @map("fecha")
  total      Decimal  @default(0) @map("total")
  estado     String   @default("Pendiente") @map("estado")
  documentos Json?    @map("documentos")
  // crm-paridad-facturas-pedidos-aa (PR-2b): vínculo idempotente factura↔pedido.
  // NULLABLE + @unique = clave de idempotencia de la auto-factura al aceptar un pedido
  // (espejo de Invoice.budgetId en agents-agency). Postgres permite múltiples NULL bajo
  // un índice único, así que las facturas manuales/del operador (pedido_id NULL) conviven
  // sin colisión; solo hay 1 factura como máximo por pedido. NO se pone `numero` como
  // único: rompería el contrato vigente (operador admite numero duplicado entre negocios).
  // onDelete: SetNull — la factura es el registro financiero durable: si el pedido se
  // borra en duro, la factura sobrevive con pedido_id NULL en vez de bloquear el borrado
  // (Restrict) o perderse (Cascade). Compatible con el Cascade de negocio→pedido/factura.
  pedidoId   String?  @unique @map("pedido_id")
  pedido     Pedido?  @relation(fields: [pedidoId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now()) @map("creado_en")
  @@index([businessId])
  eliminadoEn DateTime? @map("eliminado_en")
  @@map("factura")
}

// Presupuesto/Pedido documental (crm-paridad-facturas-pedidos-aa, Fase 1.2).
// Espejo del modelo `Budget` de agents-agency (agents-agency/back/prisma/schema.prisma)
// adaptado a las convenciones del CRM: multi-tenencia por `businessId`, dinero en `Decimal`,
// columnas castellano snake_case y soft-delete `eliminado_en`. Superficie NUEVA e
// independiente de `venta` (TPV/carrito), que no se toca. Los totales se calculan SIEMPRE
// server-side desde las líneas (nunca se confían al cliente), igual que en AA.
// La factura se auto-crea al aceptar el pedido — eso va en PR-2b (columna `pedido_id`
// @unique en `factura` + ensureInvoiceForPedido), no en este modelo.
model Pedido {
  id             String    @id @default(cuid())
  businessId     String    @map("negocio_id")
  business       Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  numero         String    @map("numero")                      // Nº presupuesto/pedido; lo envía el form (como AA), ej. AD-2026-001
  customerId     String?   @map("cliente_id")
  customer       Customer? @relation(fields: [customerId], references: [id])
  clienteSnapshot Json     @default("{}") @map("snapshot_cliente") // Snapshot del cliente al generar
  emisorSnapshot  Json     @default("{}") @map("snapshot_emisor")  // Snapshot del emisor (datos fiscales)
  estado         String    @default("generada") @map("estado")  // generada | aceptada | rechazada | caducada
  subtotalImpl   Decimal   @default(0) @map("subtotal_impl")     // Base pago único (sin IVA)
  subtotalMant   Decimal   @default(0) @map("subtotal_mant")     // Base mensual (sin IVA)
  totalImpl      Decimal   @default(0) @map("total_impl")        // Pago único con IVA
  totalMant      Decimal   @default(0) @map("total_mant")        // Mensual con IVA
  tasaIva        Decimal   @default(0.21) @map("tasa_iva")
  diasValidez    Int       @default(30) @map("dias_validez")
  notas          String?   @map("notas")
  lines          PedidoLine[]
  // crm-paridad-facturas-pedidos-aa (PR-2b): factura auto-creada al aceptar (0..1).
  // Espejo de Budget.invoice en agents-agency. La FK/@unique vive en Invoice.pedidoId.
  invoice        Invoice?
  createdAt      DateTime  @default(now()) @map("creado_en")
  updatedAt      DateTime  @updatedAt @map("actualizado_en")
  eliminadoEn    DateTime? @map("eliminado_en")

  @@index([businessId, createdAt])
  @@map("pedido")
}

model PedidoLine {
  id          String  @id @default(cuid())
  pedidoId    String  @map("pedido_id")
  pedido      Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  servicioId  String  @default("") @map("servicio_id")   // id del servicio del catálogo (o "")
  nombre      String  @map("nombre")
  descripcion String? @map("descripcion")
  cantidad    Int     @default(1) @map("cantidad")
  precioImpl  Decimal @default(0) @map("precio_impl")     // Precio puesta en marcha por unidad
  precioMant  Decimal @default(0) @map("precio_mant")     // Precio mensual por unidad
  posicion    Int     @default(0) @map("posicion")        // Orden en la tabla

  @@index([pedidoId])
  @@map("linea_pedido")
}

model Campaign {
  id         String   @id @default(cuid())
  businessId String   @map("negocio_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  nombre     String   @map("nombre")
  canal      String   @default("Email") @map("canal")
  estado     CampaignStatus @default(DRAFT) @map("estado")
  enviados   Int      @default(0) @map("enviados")
  aperturas  String?  @map("aperturas")
  createdAt  DateTime @default(now()) @map("creado_en")
  updatedAt  DateTime @updatedAt @map("actualizado_en")
  @@index([businessId])
  eliminadoEn DateTime? @map("eliminado_en")
  @@map("campana")
}

model Fichaje {
  id          String   @id @default(cuid())
  businessId  String   @map("negocio_id")
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employeeId  String?  @map("empleado_id")
  employee    Employee? @relation(fields: [employeeId], references: [id])
  empleado    String? @map("empleado_nombre")
  fecha       DateTime @default(now()) @db.Date @map("fecha")
  entrada     DateTime? @map("entrada")
  salida      DateTime? @map("salida")
  horas       Decimal? @map("horas")
  createdAt   DateTime @default(now()) @map("creado_en")
  @@index([businessId])
  eliminadoEn DateTime? @map("eliminado_en")
  @@map("fichaje")
}

// Evento de fichaje (crm-operaos WU6): registro ATÓMICO de un paso de la jornada
// (entrada / salida_comida / entrada_comida / salida_final), no un resumen entrada+salida
// como el modelo Fichaje legacy de arriba. Permite validar la secuencia por día y modo
// (ver back/src/lib/fichaje.ts) sin migrar ni perder los registros históricos de `Fichaje`.
model WorkdayEvent {
  id         String   @id @default(cuid())
  businessId String   @map("negocio_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  employeeId String   @map("empleado_id")
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  fecha      DateTime @db.Date @map("fecha")
  modo       String   @map("modo") // WorkdayMode: 'intensiva' | 'partida'
  paso       String   @map("paso") // WorkdayStep: 'entrada' | 'salida_comida' | 'entrada_comida' | 'salida_final'
  creadoEn   DateTime @default(now()) @map("creado_en")

  @@unique([employeeId, fecha, paso], name: "workday_event_uq")
  @@index([businessId, employeeId, fecha])
  @@map("evento_jornada")
}

// ----------------------------- Plataforma -----------------------------
model Notification {
  id          String   @id @default(cuid())
  businessId  String   @map("negocio_id")
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  tipo        String   @map("tipo")
  canal       String   @default("email") @map("canal")
  destino     String?  @map("destino")
  payload     Json     @default("{}") @map("payload")
  programadoEn DateTime? @map("programado_en")
  enviadoEn   DateTime? @map("enviado_en")
  estado      String   @default("pending") @map("estado")
  lockedAt    DateTime? @map("locked_at")  // claim del drainer: filas 'processing' bloqueadas (multi-instancia)
  intentos    Int      @default(0) @map("intentos")  // reintentos de envío; tope -> 'failed'
  createdAt   DateTime @default(now()) @map("creado_en")
  @@unique([tipo, businessId, destino, programadoEn])  // idempotencia: evita recordatorios duplicados
  @@index([programadoEn, estado])
  @@map("notificacion")
}

// ----------------------------- Comercial de campo -----------------------------
// crm-comercial-campo: mapa geolocalizado, estados de visita, notas, visitas, recordatorios.

// Estado de visita configurable por negocio (RF-06/07/19). Fija color/icono del marcador.
// SEPARADO de CustomerStatus (activo/inactivo) y de la categoría ABC (badge).
model VisitState {
  id          String   @id @default(cuid())
  businessId  String   @map("negocio_id")
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  nombre      String   @map("nombre")
  color       String   @default("#9ca3af") @map("color")
  icono       String   @default("MapPin") @map("icono")
  orden       Int      @default(0) @map("orden")
  esPendiente Boolean  @default(true) @map("es_pendiente")
  esSistema   Boolean  @default(false) @map("es_sistema")
  customers   Customer[]
  eliminadoEn DateTime? @map("eliminado_en")
  createdAt   DateTime @default(now()) @map("creado_en")
  @@index([businessId])
  @@map("estado_visita")
}

// Registro de visita comercial (RF-12). Al crearse actualiza Customer.ultimaVisitaEn
// y opcionalmente su estadoVisitaId (estado posterior), en transacción.
model Visit {
  id            String   @id @default(cuid())
  businessId    String   @map("negocio_id")
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId    String   @map("cliente_id")
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  employeeId    String?  @map("empleado_id")
  fecha         DateTime @default(now()) @map("fecha")
  resultado     String?  @map("resultado")
  nota          String?  @map("nota")
  proximaAccion String?  @map("proxima_accion")
  estadoPosteriorId String? @map("estado_posterior_id")
  eliminadoEn   DateTime? @map("eliminado_en")
  createdAt     DateTime @default(now()) @map("creado_en")
  @@index([businessId, customerId])
  @@map("visita")
}

// Nota de cliente INMUTABLE (RF-11, regla de negocio 6). Sin updatedAt ni eliminadoEn:
// el back expone solo POST (crear) y GET (listar). No hay edición ni borrado.
model CustomerNote {
  id         String   @id @default(cuid())
  businessId String   @map("negocio_id")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId String   @map("cliente_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  autorId    String?  @db.Uuid @map("autor_id")
  texto      String   @map("texto")
  origen     NoteOrigin @default(MANUAL) @map("origen")
  createdAt  DateTime @default(now()) @map("creado_en")
  @@index([businessId, customerId])
  @@map("nota_cliente")
}

// Recordatorio/tarea de usuario ligado a cliente (RF-16). DISTINTO de Notification
// (cola de envío email). "Vencido" = estado PENDING con fechaPrevista < now (calculado).
model Reminder {
  id            String   @id @default(cuid())
  businessId    String   @map("negocio_id")
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId    String   @map("cliente_id")
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  titulo        String   @map("titulo")
  descripcion   String?  @map("descripcion")
  fechaPrevista DateTime? @map("fecha_prevista")
  estado        ReminderStatus @default(PENDING) @map("estado")
  responsableId String?  @db.Uuid @map("responsable_id")
  origen        String   @default("manual") @map("origen")
  eliminadoEn   DateTime? @map("eliminado_en")
  createdAt     DateTime @default(now()) @map("creado_en")
  updatedAt     DateTime @updatedAt @map("actualizado_en")
  @@index([businessId, customerId])
  @@index([businessId, estado, fechaPrevista])
  @@map("recordatorio")
}

// ----------------------------- Calendario externo -----------------------------
// crm-citas-google-calendar (WU1): token opaco del feed ICS suscribible. 1 fila por
// usuario (unique userId); regenerar sobrescribe tokenHash (invalida el anterior al
// instante), revocar marca revokedAt. Sin RLS de lectura para authenticated (a
// diferencia del resto de crm.*): es un secreto, solo el backend (service role) lo lee.
model CalendarToken {
  id            String    @id @default(cuid())
  userId        String    @unique @db.Uuid @map("usuario_id")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash     String    @unique @map("token_hash")
  revokedAt     DateTime? @map("revocado_en")
  createdAt     DateTime  @default(now()) @map("creado_en")
  regeneratedAt DateTime? @map("regenerado_en")
  @@map("token_calendario")
}

// Credencial OAuth por negocio (Gmail/Calendar) o de plataforma (businessId=null,
// scope='admin'). Tokens SIEMPRE cifrados enc:v1: (AES-256-GCM, CRM_OAUTH_ENCRYPTION_KEY).
// Revoke = SOFT-delete (estado='revoked' + revokedAt), sigue el precedente CalendarToken:
// secreto backend-only, revocar sin destruir el registro (auditoría business-facing).
// Sin RLS de lectura para authenticated: es un secreto, solo el service role de Prisma lo lee.
// NOTA multi-tenant: el @@unique([businessId, servicio]) NO restringe filas con businessId
// null (Postgres trata NULL como distinto). Para credencial admin (WU3) hará falta un índice
// único parcial sobre servicio WHERE businessId IS NULL. En WU1 (Gmail per-business) el
// businessId siempre está presente, así que el unique compuesto basta.
model OAuthCredential {
  id           String              @id @default(cuid())
  businessId   String?             @map("negocio_id")
  business     Business?           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  servicio     ServicioIntegracion
  scope        String              @default("tenant") // tenant | admin
  accessToken  String              @map("token_acceso")   // cifrado enc:v1:
  refreshToken String?             @map("token_refresco") // cifrado enc:v1:
  expiresAt    DateTime?           @map("expira_en")
  scopesOauth  String[]            @map("scopes_oauth")   // scopes concedidos por el proveedor
  estado       String              @default("connected")  // connected | reauth_required | revoked
  revokedAt    DateTime?           @map("revocado_en")
  createdAt    DateTime            @default(now()) @map("creado_en")
  updatedAt    DateTime            @updatedAt @map("actualizado_en")

  @@unique([businessId, servicio])
  @@map("credencial_oauth")
}

// ----------------------------- Categorías / Deporte -----------------------------
model Team {
  id          String      @id @default(cuid())
  businessId  String      @map("negocio_id")
  business    Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  nombre      String
  deporte     DeporteType @default(OTRO)
  temporada   String?
  descripcion String?
  color       String?     // equipación local/casa
  colorVisitante String?  @map("color_visitante") // equipación visitante
  eliminadoEn DateTime?   @map("eliminado_en")
  createdAt   DateTime    @default(now()) @map("creado_en")
  updatedAt   DateTime    @updatedAt @map("actualizado_en")

  members     TeamMember[]
  bookings    Booking[]

  @@index([businessId])
  @@map("equipo")
}

model TeamMember {
  id                  String    @id @default(cuid())
  teamId              String    @map("equipo_id")
  team                Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  employeeId          String?   @map("empleado_id")
  employee            Employee? @relation(fields: [employeeId], references: [id])
  customerId          String?   @map("socio_id")
  customer            Customer? @relation(fields: [customerId], references: [id])
  rol                 String
  dorsal              String?
  posicion            String?
  activoDesde         DateTime? @map("activo_desde")
  contactosEmergencia Json      @default("[]") @map("contactos_emergencia")
  createdAt           DateTime  @default(now()) @map("creado_en")
  updatedAt           DateTime  @updatedAt @map("actualizado_en")

  @@unique([teamId, employeeId])
  @@unique([teamId, customerId])
  @@map("miembro_equipo")
}

// Agenda de contactos comerciales (leads / prospectos), paridad con Agents Agency
// (crm-operaos WU4). Código pc-NN secuencial por negocio. Soft delete (eliminadoEn).
// `tipo` = 'lead' | 'prospecto'; `contactado` = 'si' | 'no' | 'nc' (validado en la ruta con zod).
model Contacto {
  id           String    @id @default(cuid())
  businessId   String    @map("negocio_id")
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  codigo       String    @map("codigo")
  tipo         String    @default("prospecto") @map("tipo")
  nombre       String    @map("nombre")
  telefono     String?   @map("telefono")
  email        String?   @map("email")
  sector       String?   @map("sector")
  direccion    String?   @map("direccion")
  // Dirección estructurada (crm-operaos 9.2 + localidad añadida en la 2ª pasada).
  // Aditivos/nullable. Sin provincia (fuera del alcance pedido para Contacto).
  numero       String?   @map("numero")
  piso         String?   @map("piso")
  codigoPostal String?   @map("codigo_postal")
  localidad    String?   @map("localidad")
  peticion     String?   @map("peticion")
  contactado   String    @default("no") @map("contactado")
  contactadoEn DateTime? @map("contactado_en")
  clienteId    String?   @map("cliente_id")
  cliente      Customer? @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now()) @map("creado_en")
  updatedAt    DateTime  @updatedAt @map("actualizado_en")
  eliminadoEn  DateTime? @map("eliminado_en")

  @@unique([businessId, codigo], name: "contacto_negocio_codigo_uq")
  @@index([businessId])
  @@index([businessId, contactado])
  @@map("contacto")
}

// Mensajes de Telegram por tenant (crm-operaos WU5). La tabla la creó la migración
// 20260705000000_telegram_message; este modelo la espeja EXACTAMENTE (el modelo
// faltaba en el schema aunque la tabla y las rutas ya existían — routes/telegram.ts
// referencia prisma.telegramMessage con campos en inglés, la convención del repo:
// modelo inglés + columnas castellano vía @map). Idempotencia: única por (negocio,
// id de proveedor) para el webhook entrante y por (negocio, id de cliente) para la
// respuesta manual saliente. `direction` = 'in' | 'out' (validado en la ruta).
model TelegramMessage {
  id                 String   @id @default(cuid())
  businessId         String   @map("negocio_id")
  business           Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversationId     String   @map("conversacion_id")
  direction          String   @map("direccion")
  text               String   @map("texto")
  providerMessageId  String?  @map("proveedor_mensaje_id")
  clientMessageId    String?  @map("cliente_mensaje_id")
  remitente          String?  @map("remitente")
  createdAt          DateTime @default(now()) @map("creado_en")

  @@unique([businessId, providerMessageId], map: "telegram_msg_provider_uq")
  @@unique([businessId, clientMessageId], map: "telegram_msg_client_uq")
  @@index([businessId, conversationId, createdAt])
  @@map("mensaje_telegram")
}
