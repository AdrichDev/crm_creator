{
  "name": "operaos-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "migrate:status": "prisma migrate status",
    "seed": "tsx src/seed.ts",
    "test": "node --import tsx --test \"src/**/!(*.e2e).test.ts\"",
    "test:unit": "node --import tsx --test \"src/lib/__tests__/*.test.ts\"",
    "test:e2e": "node --import tsx --test \"src/**/*.e2e.test.ts\"",
    "test:all": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@supabase/supabase-js": "^2.108.2",
    "@types/multer": "^2.1.0",
    "archiver": "^7.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "jose": "^5.9.6",
    "jszip": "^3.10.1",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=20.3"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jszip": "^3.4.0",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^6.4.24",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "^7.8.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
