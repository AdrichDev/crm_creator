# Backend OperaOS
DATABASE_URL="postgresql://user:password@localhost:5432/operaos?schema=public"
PORT=4000
CORS_ORIGIN="http://localhost:3002"

# IA para extraer el diseño de la landing (paleta, tipografía, forma).
# Si se deja vacío, OperaOS usa la heurística local (solo paleta por regex).
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Automatizaciones n8n (OPCIONALES, fail-open). Si AUTOMATION_WEBHOOK_URL está vacío,
# las notificaciones de citas salen por SMTP directo (comportamiento actual) y el CRM
# arranca y opera con normalidad. Con URL configurada, los eventos van firmados (HMAC)
# a n8n, que renderiza y envía. AUTOMATION_WEBHOOK_SECRET es obligatorio si hay URL
# (sin secreto, emit se bloquea para no firmar de forma insegura).
AUTOMATION_WEBHOOK_URL=
AUTOMATION_WEBHOOK_SECRET=
AUTOMATION_MAX_ATTEMPTS=3
AUTOMATION_TIMEOUT_MS=5000
